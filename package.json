{
  "name": "teardown-vox",
  "private": true,
  "version": "0.1.0",
  "description": "Voxel heist puzzle game with total destructibility",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace apps/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc -b --force",
    "lint": "eslint . --ext .ts,.tsx",
    "issues:plan": "node tools/issues/sync-issues.mjs --dry-run",
    "issues:sync": "node tools/issues/sync-issues.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "yaml": "^2.6.1"
  }
}

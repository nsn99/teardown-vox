{
  "name": "teardown-vox",
  "private": true,
  "version": "0.1.0",
  "description": "Voxel heist puzzle game with total destructibility",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace apps/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "typecheck": "tsc -b --force",
    "lint": "eslint .",
    "issues:plan": "node tools/issues/sync-issues.mjs --dry-run",
    "issues:sync": "node tools/issues/sync-issues.mjs",
    "smoke": "npm run build --workspace apps/web && node tools/smoke/run.mjs",
    "states": "node tools/states/record.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "@types/three": "^0.171.0",
    "@vitest/coverage-v8": "^2.1.8",
    "canvas": "^3.2.3",
    "eslint": "^9.39.5",
    "playwright": "^1.63.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "yaml": "^2.6.1"
  }
}
